useDynLib(actuarialrs, .registration = TRUE)
importFrom(stats, quantile)
export(lognormal)
export(lognormal_from_mean_cv)
export(cdf)
export(variance)
export(draws)
S3method(mean, act_lognormal)
S3method(quantile, act_lognormal)
S3method(cdf, act_lognormal)
S3method(variance, act_lognormal)
S3method(draws, act_lognormal)
S3method(print, act_lognormal)
