        >>> j = cells["development_index"]
        >>> design = Design(
        ...     [[1.0] * len(j), cells["origin_index"], [float(x == 1) for x in j],
        ...      [float(x == 2) for x in j]],
        ...     ["a0", "slope", "b2", "b3"],
