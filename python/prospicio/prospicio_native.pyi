        >>> fit = boot.one_year(tri, "paid", BornhuetterFerguson(apriori=0.7), exposure="premium")
        >>> fit.cdr.components()
        [('2020',), ('2021',), ('2022',), ('2023',)]
        >>> fit.opening_reserve[0]
        0.0
        >>> fit.cdr.variance() < boot.fit(tri, "paid").reserves.variance()
        True
        """
