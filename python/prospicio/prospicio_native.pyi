        >>> cat = Layer("cat", 10.0, 10.0, premium=2.0, reinstatement_rates=[1.0])
        >>> tower = Tower([cat])
        >>> result = tower.apply(EventSet.from_years([[5.0], [15.0]]))
        >>> DealRun.from_tower("cat", tower, result, "cat").premium
