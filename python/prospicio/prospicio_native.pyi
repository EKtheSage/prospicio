@final
class Terms:
    """
    The terms of a model: an intercept, numeric columns, factors,
    interactions, polynomials, hinges, steps, bins, logs and ordinals.
    
    Build them up, then ``fit`` them to training data to learn the factor
    levels; the result builds the same design matrix on any data.
    
    Examples
    --------
    >>> from prospicio.models import Terms
    >>> data = {"age": [30.0, 45.0, 60.0], "region": ["N", "S", "W"]}
    >>> coding = Terms().intercept().numeric("age").factor("region").fit(data)
    >>> coding.names
    ['(Intercept)', 'age', 'region[S]', 'region[W]']
    """
    def __new__(cls, /) -> Terms: ...
    def bins(self, /, name: str, cuts: Sequence[float], reference: int |None = None) -> Terms:
        """
        Adds a numeric column cut into bins ``(-inf, c1], (c1, c2], ...,
        (ck, inf)`` and coded as a factor, named as R's ``cut``
        (``x[(30,45]]``).
        
        Parameters
        ----------
        name : str
        cuts : list of float
            Strictly increasing.
        reference : int, optional
            Index of the reference bin; the lowest by default.
        
        Returns
        -------
        Terms
        """
    def factor(self, /, name: str, reference: str |None = None) -> Terms:
        """
        Adds a factor in treatment coding.
        
        Parameters
        ----------
        name : str
        reference : str, optional
            Reference level; the first in sorted order by default.
        
        Returns
        -------
        Terms
        """
    def fit(self, /, data: Any) -> Coding:
        """
        Learns factor levels from training data.
        
        Parameters
        ----------
        data : dict of str to list
            Numeric columns as lists of numbers, factors as lists of strings.
        
        Returns
        -------
        Coding
        
        Raises
        ------
        ValueError
            If a column is missing or has the wrong kind.
        """
    def hinges(self, /, name: str, knots: Sequence[float]) -> Terms:
        """
        Adds hinge functions ``max(0, x - k)`` at each knot, named
        ``hinge(x,k)``.
        
        Parameters
        ----------
        name : str
        knots : list of float
            Strictly increasing.
        
        Returns
        -------
        Terms
        """
    def interaction(self, /, a: str, b: str) -> Terms:
        """
        Adds the interaction of two columns: the product of their coded
        columns, each numeric as is or a factor in treatment coding (first
        level as reference), named ``a:b``, ``a[x]:b`` or ``a[x]:b[y]``, as
        R's ``a:b`` beside main effects (CAS Monograph 5, section 5.6).
        
        Parameters
        ----------
        a : str
        b : str
        
        Returns
        -------
        Terms
        """
    def intercept(self, /) -> Terms:
        """
        Adds an intercept.
        
        Returns
        -------
        Terms
        """
    def log(self, /, name: str, base: float) -> Terms:
        """
        Adds ``log(x / base)``, named ``log(x/base)``: a log transform
        centred at a base value (CAS Monograph 5, section 5.6.2).
        
        Parameters
        ----------
        name : str
        base : float
            Positive.
        
        Returns
        -------
        Terms
        """
    def natural_spline(self, /, name: str, knots: Sequence[float], boundary: tuple[float, float] |None = None) -> Terms:
        """
        Adds a natural cubic spline with interior ``knots``, linear beyond
        the boundary knots (the training range unless given):
        ``len(knots) + 1`` columns named ``spline(x)1``, .... The basis is
        the restricted cubic one, which spans the same functions as R's
        ``splines::ns(x, knots)``: fitted values agree, coefficients differ.
        
        Parameters
        ----------
        name : str
        knots : list of float
            Interior knots, strictly increasing.
        boundary : tuple of float, optional
            The boundary knots; the training minimum and maximum by default.
        
        Returns
        -------
        Terms
        """
    def numeric(self, /, name: str) -> Terms:
        """
        Adds a numeric column.
        
        Parameters
        ----------
        name : str
        
        Returns
        -------
        Terms
        """
    def ordinal(self, /, name: str, levels: Sequence[str]) -> Terms:
        """
        Adds an ordered factor in cumulative coding: for each level after
        the first, ``1[level >= it]``, named ``x[>=level]``, so each
        coefficient is the step from the level below.
        
        Parameters
        ----------
        name : str
        levels : list of str
            The levels in order, lowest first.
        
        Returns
        -------
        Terms
        
        Examples
        --------
        >>> from prospicio.models import Terms
        >>> data = {"size": ["small", "large", "medium"]}
        >>> Terms().ordinal("size", ["small", "medium", "large"]).fit(data).names
        ['size[>=medium]', 'size[>=large]']
        """
    def orthogonal_poly(self, /, name: str, degree: int) -> Terms:
        """
        Adds orthogonal polynomials of degree 1 to ``degree`` on the
        training values, as R's ``poly(x, degree)``, named ``poly(x)1``,
        ...; the recurrence learned at ``fit`` rebuilds them on new data.
        
        Parameters
        ----------
        name : str
        degree : int
        
        Returns
        -------
        Terms
        """
    def poly(self, /, name: str, degree: int) -> Terms:
        """
        Adds raw powers ``x, x**2, ..., x**degree`` of a numeric column,
        named ``x``, ``x^2``, ....
        
        Parameters
        ----------
        name : str
        degree : int
        
        Returns
        -------
        Terms
        """
    def steps(self, /, name: str, knots: Sequence[float]) -> Terms:
        """
        Adds steps ``1[x >= k]`` at each knot, named ``step(x,k)``.
        
        Parameters
        ----------
        name : str
        knots : list of float
            Strictly increasing.
        
        Returns
        -------
        Terms
        """

@final
class Timeline:
    """
    Events over a whole term of accident months, shared by its
    underwriting years.
    
    Simulation ``j`` is one path; each event is stored once, with its time
    as a fraction of the term, and is in accident month ``floor(x * months)``
    (the last month for ``x = 1``). A cover basis splits the timeline into
    contract years: ``Tower.apply_timeline``, or ``years`` for the years
    themselves.
    
    An aggregate part of the events (``EventSet.with_aggregate_part``) has
    no time: it is spread over its accident period's months by
    ``aggregate_pattern`` and each month's amount falls to the contract
    years as an event in that month would.
    
    Parameters
    ----------
    events : EventSet
        With times (``with_uniform_times``, say) as fractions of the term.
        An aggregate part is the whole term's.
    months : int
        The number of accident months.
    aggregate_pattern : list of float, optional
        Twelve non-negative weights, one for each month of an accident
        year, that spread the aggregate part over the months (they need
        not add to 1). Uniform by default.
    
    Examples
    --------
    >>> from prospicio.aggregate import EventSet, Exposure, Timeline
    >>> events = EventSet.from_years([[100.0]], times=[[13.5 / 24]])
    >>> timeline = Timeline(events, 24)
    >>> shares = [[0.0] * 24, [0.0] * 24]
    >>> shares[0][13], shares[1][13] = 0.25, 0.75
    >>> rad = timeline.years("risks_attaching", Exposure(shares))
    >>> rad[0].events(0), rad[1].events(0)
    ([25.0], [75.0])
    """
    def __new__(cls, /, events: EventSet, months: int, aggregate_pattern: Sequence[float] |None = None) -> Timeline: ...
    def __repr__(self, /) -> str: ...
    @property
    def aggregate_pattern(self, /) -> list[float]:
        """
        The weight of each month of an accident year that spreads the
        aggregate part, as set (uniform by default).
        """
    @property
    def events(self, /) -> EventSet:
        """
        The events, with times as fractions of the term, without the
        aggregate part.
        """
    @staticmethod
    def from_years(years: Sequence[EventSet], aggregate_pattern: Sequence[float] |None = None) -> Timeline:
        """
        A timeline stitched from one event set per accident year.
        
        Each year needs times within its year and the same number of
        simulations; year ``t``'s event at time ``tau`` is at
        ``(t + tau) / T`` of the term. The years can come from
        ``EventSet.term_years`` or ``EventSet.correlated_years``. Each
        year's aggregate part stays its accident year's, spread over its
        twelve months by ``aggregate_pattern``.
        
        Parameters
        ----------
        years : list of EventSet
        aggregate_pattern : list of float, optional
            Twelve non-negative monthly weights; uniform by default.
        
        Returns
        -------
        Timeline
        
        Examples
        --------
        >>> from prospicio.aggregate import EventSet, Exposure, Timeline
        >>> from prospicio.distributions import PredictiveDistribution
        >>> part = PredictiveDistribution([], [()], [[120.0]])
        >>> year = EventSet.from_years([[]], times=[[]]).with_aggregate_part(part)
        >>> halves = [[1.0] * 6 + [0.0] * 6, [0.0] * 6 + [1.0] * 6]
        >>> even = Timeline.from_years([year])
        >>> [y.aggregate_part(0) for y in even.years("risks_attaching", Exposure(halves))]
        [[60.0], [60.0]]
        >>> december = Timeline.from_years([year], aggregate_pattern=[0.0] * 11 + [1.0])
        >>> [y.aggregate_part(0) for y in december.years("risks_attaching", Exposure(halves))]
        [[0.0], [120.0]]
        """
    @property
    def has_aggregate_part(self, /) -> bool:
        """
        Whether the timeline carries an aggregate part.
        """
    @property
    def months(self, /) -> int:
        """
        The number of accident months.
        """
    @property
    def n_sims(self, /) -> int:
        """
        The number of simulated paths.
        """
    def years(self, /, basis: str, exposure: Exposure) -> list[EventSet]:
        """
        The contract years under ``basis``, for ``Tower.apply_term``.
        
        Under ``"losses_occurring"``, contract year ``k`` takes every event
        in accident months ``12k`` to ``12k + 11`` whole; ``exposure`` gives
        only the number of years. Under ``"risks_attaching"``, underwriting
        year ``u`` takes its share of each event in each month (sums insured
        scaled alike), at its time over the months the year has a share.
        
        Parameters
        ----------
        basis : {"losses_occurring", "risks_attaching"}
        exposure : Exposure
        
        Returns
        -------
        list of EventSet
        """
    def years_with_sources(self, /, basis: str, exposure: Exposure) -> tuple[list[EventSet], list[list[int]]]:
        """
        ``years`` with each year's sources: for each of the year's losses,
        in order, its event's index among all the timeline's losses, so the
        same event can be found in every year it falls to.
        
        Returns
        -------
        tuple of (list of EventSet, list of list of int)
        """

