    ...     [2020, 2020, 2020, 2021, 2021, 2022],
    ...     [12, 24, 36, 12, 24, 12],
    ...     {"paid": [100.0, 150.0, 165.0, 110.0, 170.0, 120.0]},
    ... )
    >>> fit = OdpGlm().fit(tri, "paid")
