    >>> m = Discrete([7, 6, 5, 4, 3, 1], [0.25, 0.3, 0.09, 0.2, 0.12, 0.04])
    >>> round(m.mean(), 12), m.quantile(0.01)
    (5.2, 1.0)
    >>> round(m.tvar(0.01), 6)
