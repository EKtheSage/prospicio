        The smallest ``lam`` at which every penalized coefficient is zero.
        
        Parameters
        ----------
        design : Design
        y : list of float
        
        Returns
        -------
        float
        """
    def lambda_path(self, /, design: Design, y: Sequence[float], n: int = 100, min_ratio: float = 1e-4) -> list[float]:
        """
