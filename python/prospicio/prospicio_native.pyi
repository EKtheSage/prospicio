    >>> p = e.prepare(factors=[1.0, 1.0])
    >>> tower = Tower([Layer("200x100", 200.0, 100.0)])
    >>> b = p.burning_cost(tower, [1995, 1996], premium=[1000.0, 1000.0], development=[1.0, 1.5])
    >>> b.to_dict()["developed"]
