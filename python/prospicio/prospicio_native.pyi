class Truncated:
    """
    A severity conditioned on ``lower < X <= upper``, as ``aggregate``'s
    ``sev_lb`` and ``sev_ub``: its distribution function is
    ``(F(x) - F(lower)) / (F(upper) - F(lower))`` on the window. Layer
    moments are exact, from the inner severity's.
    
