        """
    @property
    def tail(self, /) -> Any:
        """
        The lifetime view's tail: a constant factor as a number, otherwise
        its estimator.
        """
    @property
    def tail_std_err(self, /) -> float |None:
        """
        The standard error a constant tail factor is drawn with, or
        ``None`` to keep it fixed.
        """

