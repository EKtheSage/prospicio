    >>> tri = Triangle.from_long(
    ...     [2020, 2020, 2021], [12, 24, 12],
    ...     {"paid": [100.0, 150.0, 200.0], "premium": [250.0, 250.0, 400.0]},
    ... )
    >>> fit = Benktander(apriori=0.5, n_iters=2).fit(tri, "paid", "premium")
    >>> [round(u, 2) for u in fit.ultimate]
    [150.0, 288.89]
