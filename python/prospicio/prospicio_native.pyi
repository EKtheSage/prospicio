        ----------
        p : float
            In ``[0, 1]``.
        
        Returns
        -------
        float
        """
    @property
    def values(self, /) -> list[float]:
        """
        The distinct values, ascending.
        """
    def variance(self, /) -> float:
        """
        The variance.
        
        Returns
        -------
        float
