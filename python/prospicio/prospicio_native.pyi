        ----------
        design : Design
        y : list of float
        dispersion : float
        
        Returns
        -------
        float
        """
    @property
    def names(self, /) -> list[str]:
        """
        Coefficient names.
        """
    @property
    def null_deviance(self, /) -> float:
        """
        Deviance of the intercept-and-offset model.
        """
    @property
    def p_values(self, /) -> list[float]:
