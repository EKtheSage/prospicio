@final
class ArchimedeanCopula:
    """
    An exchangeable Archimedean copula: Clayton, Gumbel, Frank or Joe.
    
    Parameters
    ----------
    family : {"clayton", "gumbel", "frank", "joe"}
    theta : float
        Positive for Clayton and Frank; at least 1 for Gumbel and Joe.
    dim : int
    
    Raises
    ------
    ValueError
        If the family is unknown or ``theta`` is out of range.
    
    Examples
    --------
    >>> from prospicio.risk import ArchimedeanCopula
    >>> c = ArchimedeanCopula("clayton", 2.0, 3)  # Kendall's tau 0.5
    >>> c.dim, c.family
    (3, 'clayton')
    """
    def __new__(cls, /, family: str, theta: float, dim: int) -> ArchimedeanCopula: ...
    def cdf(self, /, u: Sequence[float]) -> float:
        """
        The copula's distribution function at the point ``u``, each
        coordinate in ``[0, 1]``.
        
        Parameters
        ----------
        u : list of float
            One value per dimension.
        
        Returns
        -------
        float
        
        Raises
        ------
        ValueError
            If ``u`` has the wrong length or a value outside ``[0, 1]``,
            or the copula has no closed-form distribution function here.
        
        Examples
        --------
        >>> from prospicio.risk import ArchimedeanCopula
        >>> c = ArchimedeanCopula("clayton", 2.0, 2)
        >>> round(c.cdf([0.3, 0.6]), 12) == round((0.3**-2 + 0.6**-2 - 1) ** -0.5, 12)
        True
        """
    @property
    def dim(self, /) -> int:
        """
        Number of dimensions.
        """
    @property
    def family(self, /) -> str:
        """
        Family name.
        """
    def sample(self, /, n: int, seed: int) -> list[list[float]]:
        """
        ``n`` draws of uniforms; draw ``i`` uses stream ``i`` of ``seed``.
        
        Parameters
        ----------
        n : int
        seed : int
        
        Returns
        -------
        list of list of float
        """
    @property
    def theta(self, /) -> float:
        """
        Copula parameter.
        """

@final
class AsIf:
    """
    Each year's cessions under its own program and under the proposed one,
    from ``PreparedLosses.as_if``.
    
    Examples
    --------
    >>> from prospicio.pricing import LargeLossExperience
    >>> from prospicio.reinsurance import Layer, Tower
    >>> p = LargeLossExperience(["a"], [2019.5], [300.0]).prepare(factors=[1.2])
    >>> then = Tower([Layer("150 xs 150", 150.0, 150.0)])
    >>> now = Tower([Layer("200 xs 200", 200.0, 200.0)])
    >>> a = p.as_if([then], [2019], now)
    >>> a.to_dict()["historical"], [round(x, 6) for x in a.to_dict()["proposed"][0]]
    ([[150.0]], [160.0])
    """
    def __repr__(self, /) -> str: ...
    @property
    def proposed_layers(self, /) -> list[str]:
        """
        The proposed tower's layer names.
        """
    def to_dict(self, /) -> dict:
        """
        The years as columns: ``year``, ``reported_losses``,
        ``trended_losses``, and per year the lists ``historical_layers``,
        ``historical`` (one value per layer in force that year) and
        ``proposed`` (one per proposed layer).
        
        Returns
        -------
        dict of str to list
        """

@final
class AttentionCann:
    """
    A CANN whose correction is a transformer over feature tokens (an
    FT-Transformer in the CANN setting).
    
    Each numeric column is a token, and each factor's indicator columns
    (``region[B]``, ``region[C]``, ...) together form one token. A learned
    ``[CLS]`` token joins them; pre-norm blocks of multi-head
    self-attention and a feed-forward layer mix them; the ``[CLS]`` state,
    through a zero-initialized head, corrects the linear predictor, so
    training starts exactly at the GLM.
    
    Parameters
    ----------
    family : {"poisson", "gamma", "tweedie", "gaussian"}
    link : str, optional
        As for ``Cann``: log, or identity for the Gaussian.
    d_model : int, default 16
        Token width; a multiple of ``heads``.
    heads : int, default 2
    layers : int, default 2
        Transformer blocks.
    feed_forward : int, default 32
        Width of each block's feed-forward layer.
    epochs : int, default 100
    batch_size : int, default 64
    learning_rate : float, default 1e-3
    seed : int, default 0
    validation_share : float, optional
        Turns on early stopping, as for ``Cann``.
    patience : int, default 10
    power : float, optional
        The Tweedie power.
    """
    def __new__(cls, /, family: str, link: str |None = None, d_model: int = 16, heads: int = 2, layers: int = 2, feed_forward: int = 32, epochs: int = 100, batch_size: int = 64, learning_rate: float = 1e-3, seed: int = 0, validation_share: float |None = None, patience: int = 10, power: float |None = None) -> AttentionCann: ...
    def __repr__(self, /) -> str: ...
    def fit(self, /, design: Design, y: Sequence[float]) -> AttentionCannFit:
        """
        Fits the network.
        
        Parameters
        ----------
        design : Design
        y : list of float
        
        Returns
        -------
        AttentionCannFit
        
        Raises
        ------
        ValueError
            If the family or link is not supported, ``d_model`` is not a
            multiple of ``heads``, or a response is out of range.
        """

@final
class AttentionCannFit:
    """
    A fitted attention CANN, from ``AttentionCann.fit``.
    """
    def __reduce__(self, /) -> tuple[Any, tuple[str]]: ...
    def __repr__(self, /) -> str: ...
    def attention(self, /, design: Design) -> TokenAttention:
        """
        The last block's attention from ``[CLS]`` to each feature token, per
        row of ``design`` and head: where the model looked for each risk. A
        diagnostic, not a decomposition of the prediction.
        
        Returns
        -------
        TokenAttention
        
        Raises
        ------
        ValueError
            If the model has no blocks (``layers=0``).
        """
    @property
    def best_epoch(self, /) -> int |None:
        """
        With early stopping, the epoch (from 1) whose network was kept.
        """
    def correction(self, /, design: Design) -> list[float]:
        """
        The network's correction to the linear predictor, per row.
        """
    @property
    def dispersion(self, /) -> float:
        """
        Dispersion: 1 for the Poisson, otherwise Pearson's estimate.
        """
    @property
    def fitted(self, /) -> list[float]:
        """
        Fitted means on the training rows.
        """
    @staticmethod
    def from_json(text: str) -> AttentionCannFit:
        """
        Reads an artifact written by ``to_json``.
        
        Parameters
        ----------
        text : str
        
        Returns
        -------
        AttentionCannFit
        
        Raises
        ------
        ValueError
            For malformed JSON, another format, a newer format version or
            weights that do not fit the spec.
        """
    @property
    def input_hash(self, /) -> str:
        """
        Hash of the training data (design, offset, weights, response).
        """
    def predict(self, /, design: Design) -> list[float]:
        """
        Expected response for each row of ``design``.
        """
    def predict_distribution(self, /, design: Design, n_sims: int, seed: int) -> PredictiveDistribution:
        """
        Joint predictive distribution across the rows: process draws from
        the family around the predicted means.
        
        Parameters
        ----------
        design : Design
        n_sims : int
        seed : int
        
        Returns
        -------
        PredictiveDistribution
        """
    def to_json(self, /) -> str:
        """
        The fit as a JSON artifact (spec, scaling, every weight by its path,
        fitted values, provenance); ``from_json`` reads it back exactly and
        pickling uses it too.
        
        Returns
        -------
        str
        """
    @property
    def tokens(self, /) -> list[str]:
        """
        Feature tokens, in column order.
        """
    @property
    def validation_history(self, /) -> list[float]:
        """
        With early stopping, the validation mean deviance after each epoch.
        """

@final
class Backtest:
    """
    The scores of a ``diagonal_backtest``: every model on every metric and
    held-out diagonal, the diagnostics of each fit and the pointwise
    held-out log densities.
    
    The metrics (``metrics``), each scored per diagonal over the held-out
    cells that every model fits:
    
    - ``crps``: the mean over the cells of the continuous ranked
      probability score of the forecast distribution at the cell's value.
    - ``coverage``: the share of cells inside the central ``interval`` of
      their forecast draws.
    - ``actual_vs_expected``: the diagonal total over the forecast mean of
      the diagonal total.
    - ``total_crps``: the CRPS of the diagonal total from the draws summed
      per simulation.
    - ``mean_log_density``: the mean over the cells of the model's held-out
      log predictive density (NaN for a model that gives none).
    - ``total_percentile``: the share of the simulated diagonal totals at
      or below the actual total, the probability integral transform of the
      diagonal: uniform over many triangles for a calibrated model.
    
    The tables (``scores()``, ``mean()``, ``diagnostics()``) are pandas
    DataFrames when pandas is installed and dicts of lists otherwise.
    
    Examples
    --------
    >>> from prospicio.reserving import GlmCandidate, Triangle, diagonal_backtest
    >>> paid = [[100.0, 150.0, 165.0, 170.0], [110.0, 170.0, 180.0],
    ...         [120.0, 175.0], [130.0]]
    >>> rows = [(2020 + w, 12 * (d + 1), v) for w, r in enumerate(paid)
    ...         for d, v in enumerate(r)]
    >>> origin, age, values = map(list, zip(*rows))
    >>> tri = Triangle.from_long(origin, age, {"paid": values})
    >>> bt = diagonal_backtest(tri, "paid", [GlmCandidate.odp()], 1, n_sims=200)
    >>> bt
    Backtest(models=['odp'], diagonals=['2023'], metrics=6, warnings=0)
    >>> bt.warnings
    []
    """
    def __repr__(self, /) -> str: ...
    def diagnostics(self, /) -> Any:
        """
        The sampler diagnostics of each fit, one row per model and
        diagonal: ``model``, ``diagonal``, ``max_rhat``, ``min_ess_bulk``,
        ``min_ess_tail``, ``divergences`` and ``n_warnings``; a row for
        every model and diagonal, models in order. A model with no sampler
        (the GLM) has NaN in the three float columns and ``None`` in the
        two count columns (NaN in a DataFrame). A fit with warnings is
        scored like any other.
        
        Returns
        -------
        pandas.DataFrame or dict
        """
    @property
    def diagonals(self, /) -> list[str]:
        """
        The calendar period held out in each split (labelled at the
        triangle's development grain, as the ``calendar`` column of the
        cells), oldest first.
        """
    @property
    def excluded(self, /) -> list[int]:
        """
        Per diagonal, the number of held-out cells left out of the scoring
        of every model because their origin or development period has no
        training cell that every model fits on.
        """
    @property
    def log_densities(self, /) -> dict:
        """
        Each model's held-out log predictive density of every scored row,
        diagonals in order, by model name; ``None`` for a model that gives
        none. Every model's list is for the same rows, so the lists are
        the input of the stacking functions.
        """
    def mean(self, /) -> Any:
        """
        The mean of each metric over the diagonals, one row per model:
        the column ``model`` and one column per metric. A metric that is NaN
        on a diagonal (``mean_log_density`` of a model with no density) is
        NaN in the mean.
        
        Returns
        -------
        pandas.DataFrame or dict
        """
    @property
    def metrics(self, /) -> list[str]:
        """
        Metric names, in the order of ``scores()``: ``crps``,
        ``coverage``, ``actual_vs_expected``, ``total_crps``,
        ``mean_log_density`` and ``total_percentile``.
        """
    @property
    def models(self, /) -> list[str]:
        """
        Model names, in the order given.
        """
    @property
    def n_splits(self, /) -> int:
        """
        Number of held-out diagonals.
        """
    @property
    def scored_rows(self, /) -> list[list[int]]:
        """
        Per diagonal, the rows of the cell table that were scored (origin
        by development, row-major, counted from 0; R's ``scored_rows``
        count from 1), in the order of
        ``log_densities``.
        """
    def scores(self, /) -> Any:
        """
        Every score as a long table with one row per model, diagonal and
        metric: columns ``model``, ``diagonal``, ``metric`` and ``value``.
        
        Returns
        -------
        pandas.DataFrame or dict
        """
    @property
    def warnings(self, /) -> list[tuple[str, str, str]]:
        """
        Every failed diagnostic threshold as ``(model, diagonal,
        message)``, in model then diagonal order; empty when every fit
        passed.
        """

@final
class BayesBf:
    """
    The Bayesian Bornhuetter–Ferguson of England, Verrall and Wüthrich
    (2012, Model 3.1):the over-dispersed Poisson model of a cumulative
    triangle's incremental values ``X`` with mean ``mu[w] * gamma[d]``, an
    informative gamma prior on each origin's row parameter ``mu[w]`` with
    mean ``apriori * exposure[w]`` and coefficient of variation ``cv``, a
    vague normal prior on each ``log gamma[d]`` (the pattern is not
    normalised), and the
    chain ladder's Pearson scale ``phi`` (``OdpBootstrapFit.scale``) plugged
    in. The posterior is sampled with NUTS, and each draw projects the
    future cells up to the oldest observed age (no tail) with the process
    error of ``process``, as ``BayesOdp`` does.
    
    The prior's strength moves the reserve between two limits. With
    ``cv=float("inf")`` (a flat prior on ``log mu[w]``) the model is the
    Bayesian chain ladder, and the reserves agree with ``BayesOdp``'s within
    Monte Carlo error. As ``cv`` falls to 0, ``mu[w]`` is fixed at the prior
    ultimate ``m[w]`` and each origin's mean reserve tends to ``m[w]`` times
    the sum of the future ``S[d] / M[d]`` (``S[d]`` the observed increments
    of column ``d``, ``M[d]`` the prior ultimates of the origins observed
    there): EVW's strong-prior limit, Mack's (2008) Bornhuetter–Ferguson
    with the raw pattern. That equals the classical
    ``BornhuetterFerguson`` reserve ``(1 - 1 / cdf) * m[w]`` only when the
    prior ultimates are the chain ladder's.
    
