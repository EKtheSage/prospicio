        Parameters
        ----------
        term : float
        
        Returns
        -------
        float
        """
    @staticmethod
    def calendar(start: float, end: float) -> Period:
        """
        Premium earned (losses occurring) in ``[start, end)``.
        
        Parameters
        ----------
        start : float
        end : float
        
        Returns
        -------
        Period
        """
    @property
    def kind(self, /) -> str:
        """
        ``"calendar"`` or ``"policy"``.
        """
    @staticmethod
    def policy(start: float, end: float) -> Period:
        """
        Policies written in ``[start, end)``, over their whole term.
        
        Parameters
        ----------
        start : float
        end : float
        
        Returns
        -------
        Period
        """

