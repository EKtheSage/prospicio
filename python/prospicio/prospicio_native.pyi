    def predict_distribution(self, /, design: Design, n_sims: int, seed: int) -> PredictiveDistribution:
        """
        Joint predictive distribution across the rows: process draws from
        the family and dispersion around the predicted means.
        
        Parameters
        ----------
        design : Design
        n_sims : int
        seed : int
        
        Returns
        -------
        PredictiveDistribution
        """

@final
class PairCopula:
    """
    A bivariate copula for a vine: a family, its parameter and a rotation.
    
    Parameters
    ----------
    family : {"independence", "gaussian", "clayton", "gumbel", "frank", "joe"}
    parameter : float, default 0.0
        Gaussian correlation in (-1, 1); Clayton above 0; Gumbel and Joe at
        least 1; Frank not 0 (negative for negative dependence).
    rotation : {0, 90, 180, 270}, default 0
        For Clayton, Gumbel and Joe: 90 and 270 give negative dependence,
        180 moves the tail dependence to the other corner (pyvinecopulib's
        conventions).
    
    Examples
    --------
    >>> from prospicio.risk import PairCopula
    >>> c = PairCopula("clayton", 2.0)
    >>> round(c.h2(0.3, 0.6), 12) == round(0.6**-3 * (0.3**-2 + 0.6**-2 - 1) ** -1.5, 12)
    True
    """
    def __new__(cls, /, family: str, parameter: float = 0.0, rotation: int = 0) -> PairCopula: ...
    def __repr__(self, /) -> str: ...
    def cdf(self, /, u: float, v: float) -> float:
        """
        The distribution function ``C(u, v)``.
        """
    def density(self, /, u: float, v: float) -> float:
        """
        The density ``c(u, v)``.
        """
    @property
    def family(self, /) -> str:
        """
        Family name.
        """
    def h1(self, /, v: float, u: float) -> float:
        """
        ``h1(v | u) = dC(u, v)/du``: the second argument given the first.
        """
    def h1_inverse(self, /, p: float, u: float) -> float:
        """
        The ``v`` with ``h1(v | u) = p``.
        """
    def h2(self, /, u: float, v: float) -> float:
        """
        ``h2(u | v) = dC(u, v)/dv``: the first argument given the second.
        """
    def h2_inverse(self, /, p: float, v: float) -> float:
        """
        The ``u`` with ``h2(u | v) = p``.
        """
    @property
    def parameter(self, /) -> float:
        """
        The parameter.
        """
    @property
    def rotation(self, /) -> int:
        """
        The rotation in degrees.
        """

@final
class Pareto:
    """
    Single-parameter Pareto: ``P(X > x) = (t / x) ** alpha`` for ``x >= t``,
    optionally truncated (conditioned on ``X < truncation``).
    
    Parameters
    ----------
    t : float
        Threshold; finite and positive.
    alpha : float
        Pareto alpha; finite and positive.
    truncation : float, optional
        Truncation point above ``t``.
    
    Raises
    ------
    ValueError
        If a parameter is out of range.
    
    Examples
    --------
    >>> from prospicio.distributions import Pareto
    >>> p = Pareto(500.0, 2.0)
    >>> round(p.layer(4000.0, 1000.0), 9)
    200.0
    """
    def __getnewargs__(self, /) -> tuple[float, float, float |None]: ...
    def __new__(cls, /, t: float, alpha: float, truncation: float |None = None) -> Pareto: ...
    def __repr__(self, /) -> str: ...
    @property
    def alpha(self, /) -> float:
        """
        Pareto alpha.
        """
    def cdf(self, /, x: float) -> float:
        """
        Distribution function ``P(X <= x)``.
        
        Parameters
        ----------
        x : float
        
        Returns
        -------
        float
        """
    @staticmethod
    def fit(losses: Sequence[float], t: float, reporting_thresholds: Sequence[float] |None = None, censored: Sequence[bool] |None = None, weights: Sequence[float] |None = None, truncation: float |None = None) -> Pareto:
        """
        Maximum likelihood fit of the alpha to large losses at or above
        ``t``.
        
        Parameters
        ----------
        losses : list of float
        t : float
            Threshold of the fitted Pareto.
        reporting_thresholds : list of float, optional
            Per-loss thresholds below which a loss would not have been
            reported; raised to ``t``.
        censored : list of bool, optional
            ``True`` where a loss was capped by a policy limit.
        weights : list of float, optional
        truncation : float, optional
        
        Returns
        -------
        Pareto
        
        Examples
        --------
        >>> from prospicio.distributions import Pareto
        >>> round(Pareto.fit([1500.0, 2500.0, 4000.0], 1000.0).alpha, 6)
        1.10524
        """
    @staticmethod
    def fit_with_standard_error(losses: Sequence[float], t: float, reporting_thresholds: Sequence[float] |None = None, censored: Sequence[bool] |None = None, weights: Sequence[float] |None = None, truncation: float |None = None) -> tuple[Pareto, float]:
        """
        ``Pareto.fit`` with the standard error of the alpha from the
        observed information. Untruncated it is ``alpha / sqrt(n)``, ``n``
        the uncensored weight; truncated, the conditioning terms add to the
        information. Parameters as ``fit``.
        
        Returns
        -------
        tuple of (Pareto, float)
        
        Examples
        --------
        >>> from prospicio.distributions import Pareto
        >>> fit, se = Pareto.fit_with_standard_error([1500.0, 2500.0, 4000.0], 1000.0)
        >>> round(se * 3 ** 0.5 / fit.alpha, 12)
        1.0
        """
    def layer(self, /, limit: float, attachment: float) -> float:
        """
        Expected loss to the layer ``limit`` xs ``attachment``.
        
        Parameters
        ----------
        limit : float
            ``inf`` for an unlimited layer.
        attachment : float
        
        Returns
        -------
        float
        """
    def layer_second_moment(self, /, limit: float, attachment: float) -> float:
        """
        Second moment of the loss to the layer ``limit`` xs
        ``attachment``.
        
        Parameters
        ----------
        limit : float
        attachment : float
        
        Returns
        -------
        float
        """
    def layer_third_moment(self, /, limit: float, attachment: float) -> float:
        """
        Third moment of the loss to the layer ``limit`` xs ``attachment``,
        ``E[min(max(X - a, 0), l)^3]``, by quadrature of the survival
        function (relative accuracy about 1e-10); ``limit = inf`` for the
        unlimited layer, ``attachment = 0`` for the limited third moment.
        
        Parameters
        ----------
        limit : float
        attachment : float
        
        Returns
        -------
        float
        """
    def layer_variance(self, /, limit: float, attachment: float) -> float:
        """
        Variance of the loss to the layer ``limit`` xs ``attachment``.
        
        Parameters
        ----------
        limit : float
        attachment : float
        
        Returns
        -------
        float
        """
    def lev(self, /, limit: float) -> float:
        """
        Limited expected value ``E[min(X, limit)]``.
        
        Parameters
        ----------
        limit : float
        
        Returns
        -------
        float
        """
    def mean(self, /) -> float:
        """
        Mean of the distribution (``inf`` if it does not exist).
        
        Returns
        -------
        float
        """
    def quantile(self, /, p: float) -> float:
        """
        Quantile: the smallest ``x`` with ``P(X <= x) >= p``.
        
        Parameters
        ----------
        p : float
            Probability in ``[0, 1]``.
        
        Returns
        -------
        float
        
        Raises
        ------
        ValueError
            If ``p`` is outside ``[0, 1]``.
        """
    def sample(self, /, n: int, seed: int, stream: int = 0) -> list[float]:
        """
        ``n`` draws from stream ``stream`` of the generator keyed by
        ``seed``.
        
        Parameters
        ----------
        n : int
        seed : int
        stream : int, default 0
        
        Returns
        -------
        list of float
        """
    def std(self, /) -> float:
        """
        Standard deviation of the distribution.
        
        Returns
        -------
        float
        """
    def stop_loss(self, /, retention: float) -> float:
        """
        Expected excess over a retention, ``E[max(X - retention, 0)]``.
        
        Parameters
        ----------
        retention : float
        
        Returns
        -------
        float
        """
    def survival(self, /, x: float) -> float:
        """
        Survival function ``P(X > x)``, accurate far into the tail.
        
        Parameters
        ----------
        x : float
        
        Returns
        -------
        float
        """
    @property
    def t(self, /) -> float:
        """
        Threshold ``t``.
        """
    @property
    def truncation(self, /) -> float |None:
        """
        Truncation point, or ``None``.
        """
    def tvar(self, /, p: float) -> float:
        """
        Tail value at risk at ``p`` in ``[0, 1)``, the mean of the worst
        ``1 - p``: ``VaR(p) + E[(X - VaR(p))+] / (1 - p)``; ``inf`` where the
        mean is.
        
        Parameters
        ----------
        p : float
        
        Returns
        -------
        float
        """
    def var(self, /, p: float) -> float:
        """
        Value at risk, the lower quantile at ``p``: the same as ``quantile``.
        
        Parameters
        ----------
        p : float
        
        Returns
        -------
        float
        """
    def variance(self, /) -> float:
        """
        Variance of the distribution (``inf`` if it does not exist).
        
        Returns
        -------
        float
        """

@final
class ParetoAnchor:
    """
    The Pareto above a threshold fitted to trended losses, with claims
    closed at their policy limit censored: ``alpha = uncensored count /
    sum ln(y / t)``, its standard error ``alpha / sqrt(n)``, and the number
    of exceedances it rests on.
    
    Examples
    --------
    >>> from prospicio.pricing import ParetoAnchor
    >>> a = ParetoAnchor.fit(1e6, [1.5e6, 2.5e6, 4e6, 2e6], censored=[False, False, False, True])
    >>> (a.exceedances, a.censored)
    (4, 1)
    """
    def __repr__(self, /) -> str: ...
    @property
    def alpha(self, /) -> float:
        """
        The censored maximum likelihood alpha.
        """
    @property
    def censored(self, /) -> int:
        """
        Of which censored at a policy limit.
        """
    @property
    def exceedances(self, /) -> int:
        """
        Losses at or above the threshold.
        """
    @staticmethod
    def fit(threshold: float, losses: Sequence[float], censored: Sequence[bool] |None = None) -> ParetoAnchor:
        """
        Fits the Pareto from ``threshold`` to the ``losses`` at or above it.
        
        Parameters
        ----------
        threshold : float
        losses : list of float
        censored : list of bool, optional
            Where a loss was closed at its policy limit; none by default.
        """
    def interval(self, /, z: float) -> tuple[float, float]:
        """
        The alpha ``± z`` standard errors, the lower end kept above 0.
        """
    @property
    def standard_error(self, /) -> float:
        """
        Its standard error from the observed information, ``alpha / sqrt(n)``.
        """
    @property
    def threshold(self, /) -> float:
        """
        The Pareto's threshold.
        """

@final
class ParetoShape:
    """
    Pinto and Gogol's Pareto shape drift above a threshold: the claims above
    ``threshold`` are Pareto at every development age, with a shape that moves
    with maturity, and the layer's development follows from a base
    development the triangle column holds (Pinto and Gogol, PCAS 74 (1987);
    Bear, PCAS 79 (1992)).
    
    Parameters
    ----------
    threshold : float
        The threshold above which claims are Pareto.
    alphas : dict of int to float
        The Pareto shape at every development age of the column, by age in
        months (none is interpolated).
    ultimate_alpha : float
        The shape of the fully developed claims.
    base : {"counts"} or ExcessLayer, default "counts"
        What the triangle column holds: ``"counts"`` for the number of
        claims above the threshold, or an ``ExcessLayer`` (attaching at or
        above the threshold) for the losses in a base layer, such as
        ``ExcessLayer(threshold)`` for the losses excess of the threshold.
    
    Examples
    --------
    >>> from prospicio.reserving import ParetoShape
    >>> ParetoShape(100.0, {12: 1.0, 24: 1.5}, 2.0).base
    'counts'
    """
    def __new__(cls, /, threshold: float, alphas: Any, ultimate_alpha: float, base: Any |None = None) -> ParetoShape: ...
    def __repr__(self, /) -> str: ...
    @property
    def alphas(self, /) -> dict:
        """
        The shapes by age in months.
        """
    @property
    def base(self, /) -> Any:
        """
        ``"counts"``, or the ``ExcessLayer`` of the base losses.
        """
    @property
    def threshold(self, /) -> float:
        """
        The threshold above which claims are Pareto.
        """
    @property
    def ultimate_alpha(self, /) -> float:
        """
        The shape of the fully developed claims.
        """

@final
class PaymentPattern:
    """
    The share of the ultimate loss paid at each time, in years from the
    treaty's inception.
    
    With a pattern that does not depend on the size of the loss, every
    simulated year's present value is its loss times ``discount_factor``, so
    a loss distribution is discounted by scaling it.
    
    Parameters
    ----------
    times : list of float
        Non-negative, strictly increasing times, in years from inception.
    shares : list of float
        The share paid at each time; they sum to 1.
    
    Examples
    --------
    >>> from prospicio.pricing import PaymentPattern
    >>> p = PaymentPattern.from_development([1.0, 2.0, 3.0], [4.0, 1.25, 1.0])
    >>> [round(s, 12) for s in p.shares]
    [0.25, 0.55, 0.2]
    >>> round(p.duration, 12), round(p.discount_factor(0.05), 6)
    (1.95, 0.909729)
    """
    def __new__(cls, /, times: Sequence[float], shares: Sequence[float]) -> PaymentPattern: ...
    def __repr__(self, /) -> str: ...
    def capital_years(self, /, rate: float) -> float:
        """
        The discounted capital years per unit of initial capital: capital
        held in each year in proportion to the share outstanding at its
        start, charged at the start of the year.
        
        Parameters
        ----------
        rate : float
        
        Returns
        -------
        float
        """
    def discount_factor(self, /, rate: float) -> float:
        """
        The present value at inception of a unit of ultimate loss, at an
        annual effective ``rate``.
        
        Parameters
        ----------
        rate : float
        
        Returns
        -------
        float
        """
    @property
    def duration(self, /) -> float:
        """
        The mean time to payment, undiscounted.
        """
    @staticmethod
    def from_development(ages: Sequence[float], factors: Sequence[float]) -> PaymentPattern:
        """
        From development factors to ultimate by age, such as a paid chain
        ladder's ``cdf``: the share paid by each age is one over its factor.
        
        The last factor must be 1 (add any tail as a last age). Ages are read
        as times from inception; ``shifted`` moves the pattern when losses
        start developing later.
        
        Parameters
        ----------
        ages : list of float
        factors : list of float
        
        Returns
        -------
        PaymentPattern
        """
    def outstanding(self, /, t: float) -> float:
        """
        The share not yet paid at time ``t``.
        
        Parameters
        ----------
        t : float
        
        Returns
        -------
        float
        """
    def paid_by(self, /, t: float, interpolation: str = "step") -> float:
        """
        The share paid by time ``t`` in years, read between the pattern's
        times by ``interpolation``: ``"step"`` (each share paid at its
        time), ``"linear"`` (evenly over the period ending at it) or
        ``"log-linear"`` (the unpaid share falling geometrically).
        
        Examples
        --------
        >>> from prospicio.pricing import PaymentPattern
        >>> p = PaymentPattern([1.0, 2.0], [0.6, 0.4])
        >>> p.paid_by(0.5), round(p.paid_by(0.5, "linear"), 12)
        (0.0, 0.3)
        """
    @property
    def shares(self, /) -> list[float]:
        """
        The share paid at each time.
        """
    def shifted(self, /, by: float) -> PaymentPattern:
        """
        The pattern ``by`` years later.
        
        Parameters
        ----------
        by : float
        
        Returns
        -------
        PaymentPattern
        """
    @property
    def times(self, /) -> list[float]:
        """
        The times.
        """
    def to_monthly(self, /, months: int, interpolation: str = "linear") -> list[float]:
        """
        The cumulative share paid at the end of each of ``months`` months,
        ``paid_by((m + 1) / 12)``: at month ``12 k - 1`` the pattern's share
        at ``k`` years. The monthly paid pattern of ``CashflowTerms``.
        
        Examples
        --------
        >>> from prospicio.pricing import PaymentPattern
        >>> p = PaymentPattern.from_development([1.0, 2.0, 3.0], [4.0, 1.25, 1.0])
        >>> m = p.to_monthly(36)
        >>> round(m[11], 12), round(m[23], 12), m[35]
        (0.25, 0.8, 1.0)
        """
    def unpaid_from(self, /, age: float) -> PaymentPattern:
        """
        The pattern of what is unpaid at ``age``, with times measured from
        ``age``: the payments after it, each over the share outstanding. For
        a reserve valued at ``age``, such as one ceded under a loss portfolio
        transfer; payments at ``age`` itself count as paid.
        
        Parameters
        ----------
        age : float
        
        Returns
        -------
        PaymentPattern
        
        Examples
        --------
        >>> from prospicio.pricing import PaymentPattern
        >>> p = PaymentPattern([1.0, 2.0, 3.0, 4.0], [0.25] * 4).unpaid_from(2.0)
        >>> p.times, p.shares
        ([1.0, 2.0], [0.5, 0.5])
        """

