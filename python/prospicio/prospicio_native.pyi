        Parameters
        ----------
        x : float
        
        Returns
        -------
        float
        """
    def mean(self, /) -> float:
        """
        The mean.
        
        Returns
        -------
        float
        """
    def pmf(self, /, x: float) -> float:
        """
        The probability of exactly ``x`` (to ``1e-12``).
        
        Parameters
        ----------
        x : float
        
        Returns
