@final
class ExcessPattern:
    """
    A layer's development pattern derived from the ground-up triangle:
    the layer's age-to-age factors, its factors to ultimate and its tail,
    from the ground-up incurred factors and a severity by maturity
    (Bloom and Patrik, CAS E-Forum Fall 2013; Sahasrabuddhe, E-Forum Fall
    2010; Pinto and Gogol, PCAS 74 (1987)). Build one with
    ``ExcessPattern.from_ground_up``.
    
    The pattern goes into ``ChainLadder``, ``Mack`` and the expected-loss
    methods of a *layer* triangle through ``selected``, which gives their
    ``ldf``, ``ldf_kind`` and ``ldf_weight`` arguments, and ``tail``:
    ``ChainLadder(tail=p.tail, **p.selected(weight))``.
    
    Examples
    --------
    Bloom and Patrik's four claims (100, 375, 250 and 500 at 12 months)
    developing 3.60 and 1.25 to ultimate, in the layer excess of 350.
    
    >>> from prospicio.distributions import Grid
    >>> from prospicio.reserving import ExcessLayer, ExcessPattern, ScaleShift, Triangle
    >>> tri = Triangle.from_long(
    ...     [2020, 2020, 2020], [12, 24, 36],
    ...     {"incurred": [1225.0, 4410.0, 5512.5]},
    ... )
    >>> probs = [0.0] * 21
    >>> for j in (4, 15, 10, 20):
    ...     probs[j] = 0.25
    >>> ultimate = Grid(112.5, probs)
    >>> p = ExcessPattern.from_ground_up(
    ...     tri, "incurred", ExcessLayer(350.0), ScaleShift(ultimate)
    ... )
    >>> round(p.layer_ldf[0], 6), round(p.layer_cdf[0], 6)
    (17.2, 23.5)
    """
    def __repr__(self, /) -> str: ...
    @property
    def ages(self, /) -> list[int]:
        """
        Development ages (months) of the ground-up triangle.
        """
    def credibility_weights(self, /, layer_triangle: Triangle, column: str, k: float, max_influence: float, counts: str |None = None) -> dict:
        """
        The weight on the derived pattern at each age, ``1 - z`` with
        ``z = n / (n + k)``, ``n`` the layer triangle's claim count (or its
        origins with a positive earlier value without counts) at the earlier
        age and ``k`` the credibility constant, capped so that removing any
        one origin moves the blended factor by at most ``max_influence`` of
        it. Where the layer's own factor cannot be estimated the weight is 1.
        
        Parameters
        ----------
        layer_triangle : Triangle
            The layer's own triangle, a single segment on the pattern's ages.
        column : str
            The layer loss column.
        k : float
            The credibility constant, positive. No default (design note,
            decision 19): the simulation study favours about 20.
        max_influence : float
            The share of the blended factor one origin may move, positive.
        counts : str, optional
            The layer's claim count column on the same origins and ages.
        
        Returns
        -------
        dict of int to float
            The weight at each age except the oldest, for ``ldf_weight``.
        """
    @staticmethod
    def from_ground_up(triangle: Triangle, column: str, layer: Any, model: Any, counts: str |None = None, tail: Any |None = None, basis: str = "incurred") -> ExcessPattern:
        """
        The layer pattern from the ground-up incurred column, an optional
        claim count column and the ground-up tail.
        
        Parameters
        ----------
        triangle : Triangle
            A single-segment triangle holding the ground-up column.
        column : str
            The ground-up incurred (reported) loss column. Under a
            ``ParetoShape`` it is the base development the model names (its
            counts above the threshold, or its base losses).
        layer : ExcessLayer
            The layer, with positive expected loss at every age in the model.
        model : ScaleShift or ParetoShape
            How the severity at each maturity relates to the ultimate one.
        counts : str, optional
            A reported claim count column on the same ages. Without it the
            counts are taken as complete at every age, which mixes frequency
            development into the severity shift. Not allowed with a
            ``ParetoShape``.
        tail : float or tail estimator, optional
            The ground-up tail of the chain ladder: it fixes one more shift
            for the oldest age and the layer's tail. No tail by default.
        basis : {"incurred"}, default "incurred"
            The loss basis of the column. Only ``"incurred"`` is derived;
            ``"paid"`` is an error (design note, decision 9).
        
        Returns
        -------
        ExcessPattern
        """
    @property
    def ground_up_ldf(self, /) -> list[float]:
        """
        The ground-up age-to-age factors the pattern was derived from.
        """
    @property
    def ground_up_tail(self, /) -> float:
        """
        The ground-up factor from the oldest age to ultimate.
        """
    @property
    def layer_cdf(self, /) -> list[float]:
        """
        The layer's factors from each age to ultimate, with the tail.
        """
    @property
    def layer_ldf(self, /) -> list[float]:
        """
        The layer's age-to-age factors, one fewer than the ages.
        """
    @property
    def ldf(self, /) -> dict:
        """
        The layer's age-to-age factors as a dict from age in months, the
        ``ldf`` argument of the methods with ``ldf_kind="ldf"``.
        """
    def selected(self, /, weight: Any |None = None) -> dict:
        """
        The derived pattern as the arguments of the chain ladder, Mack and
        the expected-loss methods.
        
        Parameters
        ----------
        weight : float or dict, default 1.0
            The weight on the derived factors, a number or a dict from age
            in months to a number (``credibility_weights`` gives one); the
            rest goes to the factors estimated from the layer triangle.
            Weight 1 selects the derived factors alone, which a sparse layer
            triangle needs.
        
        Returns
        -------
        dict
            ``ldf``, ``ldf_kind`` and ``ldf_weight``, to be passed as keyword
            arguments. The layer's tail is separate: ``tail``.
        """
    @property
    def shifts(self, /) -> list[float]:
        """
        The scale shift of each age, the last for the tail; empty under a
        ``ParetoShape``.
        """
    @property
    def tail(self, /) -> float:
        """
        The layer's factor from the oldest age to ultimate (1 without a
        ground-up tail under a scale shift). Pass it as the ``tail`` of the
        layer's chain ladder.
        """

@final
class ExpectedLoss:
    """
    The expected loss ratio method: each origin's ultimate is ``apriori``
    times its exposure, whatever has been observed. The chain ladder is
    still fitted for the development pattern the fit reports.
    
    The exposure is a measure column of the same triangle (premium, say):
    each origin's latest observed cumulative value in the segment fitted.
    
    Parameters
    ----------
    apriori : float, default 1.0
        Expected loss ratio: the ultimate per unit of exposure; positive.
    average : {"volume", "simple", "regression", "geometric"}, default "volume"
        How link ratios are averaged, as in ``ChainLadder``.
    sigma_interpolation : {"log-linear", "mack"}, default "log-linear"
    n_periods, drop_high, drop_low : optional
        As ``ChainLadder``: average only the latest diagonals and leave out
        the highest and lowest link ratios at each age.
    tail : float, TailConstant, TailCurve, TailBondy or TailLogLinear, optional
        As ``ChainLadder``; no tail by default.
    ldf, ldf_kind, ldf_weight : optional
        A selected development pattern, as in ``ChainLadder``: the
        development pattern's factors at the ages it gives, so ``cdf`` and
        the share developed ``1 / cdf`` follow it.
    
    Examples
    --------
    >>> from prospicio.reserving import ExpectedLoss, Triangle
    >>> tri = Triangle.from_long(
    ...     [2020, 2020, 2021], [12, 24, 12],
    ...     {"paid": [100.0, 150.0, 200.0], "premium": [250.0, 250.0, 400.0]},
    ... )
    >>> fit = ExpectedLoss(apriori=0.5).fit(tri, "paid", "premium")
    >>> fit.ultimate, fit.reserve
    ([125.0, 200.0], [-25.0, 0.0])
    """
    def __new__(cls, /, apriori: float = 1.0, average: str = "volume", sigma_interpolation: str = "log-linear", tail: Any |None = None, ldf: Any |None = None, ldf_kind: str |None = None, ldf_weight: Any |None = None, n_periods: int |None = None, drop_high: int = 0, drop_low: int = 0) -> ExpectedLoss: ...
    def __repr__(self, /) -> str: ...
    @property
    def apriori(self, /) -> float:
        """
        Expected loss ratio.
        """
    @property
    def average(self, /) -> str:
        """
        How link ratios are averaged.
        """
    @property
    def drop_high(self, /) -> int:
        """
        Highest link ratios left out at each age.
        """
    @property
    def drop_low(self, /) -> int:
        """
        Lowest link ratios left out at each age.
        """
    def fit(self, /, triangle: Triangle, column: str, exposure: str) -> ExpectedLossFit:
        """
        Fits one loss column in every segment of a triangle, each with its
        own exposure.
        
        Parameters
        ----------
        triangle : Triangle
        column : str
            The losses to project.
        exposure : str
            The exposure column; each origin's latest observed cumulative
            value is its exposure (an incremental triangle's is cumulated).
        
        Returns
        -------
        ExpectedLossFit
        
        Raises
        ------
        ValueError
            As ``ChainLadder.fit``, if ``apriori`` is not positive, or if an
            origin has no observed, finite, positive exposure (the message
            names it and, with keys, its segment).
        """
    @property
    def ldf(self, /) -> dict |None:
        """
        The selected pattern by age, as given; ``None`` without one.
        """
    @property
    def ldf_kind(self, /) -> str |None:
        """
        How ``ldf`` is expressed: ``"ldf"``, ``"cdf"`` or
        ``"percent_developed"``; ``None`` without a pattern.
        """
    @property
    def ldf_weight(self, /) -> Any |None:
        """
        The weight on the selected factors: a number, a dict by age, or
        ``None`` without a pattern.
        """
    @property
    def n_periods(self, /) -> int |None:
        """
        Number of latest diagonals averaged; ``None`` uses every link ratio.
        """
    @property
    def sigma_interpolation(self, /) -> str:
        """
        How unestimable variance parameters are filled in.
        """
    @property
    def tail(self, /) -> Any:
        """
        The tail: a constant factor as a number, otherwise its estimator.
        """

@final
class ExpectedLossFit:
    """
    A fitted expected-loss method (``ExpectedLoss``,
    ``BornhuetterFerguson`` or ``Benktander``) of every segment of a
    triangle column.
    
    Per-origin lists (``origins``, ``latest``, ``exposure``, ``apriori``,
    ``ultimate``, ``reserve``) run over the origins of each segment in turn,
    like the rows of ``to_frame()``. ``ultimate`` and ``reserve`` are this
    method's; ``chain_ladder`` holds the chain ladder's. Per-age lists need
    a single-segment fit; for several segments use ``development_frame()``
    or ``segment(...)``.
    
    Examples
    --------
    >>> from prospicio.reserving import BornhuetterFerguson, Triangle
    >>> tri = Triangle.from_long(
    ...     [2020, 2020, 2021] * 2,
    ...     [12, 24, 12] * 2,
    ...     {"paid": [100.0, 150.0, 200.0, 10.0, 20.0, 30.0],
    ...      "premium": [250.0, 250.0, 400.0, 500.0, 500.0, 800.0]},
    ...     keys={"lob": ["Auto"] * 3 + ["Home"] * 3},
    ... )
    >>> fit = BornhuetterFerguson(apriori=0.5).fit(tri, "paid", "premium")
    >>> fit.exposure, fit.segment(lob="Home").ultimate
    ([250.0, 400.0, 500.0, 800.0], [20.0, 230.0])
    """
    def __repr__(self, /) -> str: ...
    @property
    def apriori(self, /) -> list[float]:
        """
        Expected loss ratio applied per origin.
        """
    @property
    def cdf(self, /) -> list[float]:
        """
        Age-to-ultimate factors, one per age, including the tail.
        """
    @property
    def chain_ladder(self, /) -> ChainLadderFit:
        """
        The underlying chain-ladder projection, with the chain ladder's
        ultimate.
        """
    @property
    def development(self, /) -> list[int]:
        """
        Development ages in months.
        """
    def development_frame(self, /) -> Any:
        """
        One row per segment and age, as ``ChainLadderFit.development_frame``.
        Needs pandas.
        
        Returns
        -------
        pandas.DataFrame
        """
    @property
    def exposure(self, /) -> list[float]:
        """
        Exposure per origin: the exposure column's latest observed cumulative
        value.
        """
    @property
    def index(self, /) -> list[Any]:
        """
        Label of each segment, as ``Triangle.index``.
        """
    @property
    def keys(self, /) -> list[str]:
        """
        Names of the triangle's key columns; empty without keys.
        """
    @property
    def latest(self, /) -> list[float]:
        """
        Latest observed cumulative value per origin.
        """
    @property
    def ldf(self, /) -> list[float]:
        """
        Age-to-age factors; factor ``k`` links age ``k`` to ``k + 1``.
        """
    @property
    def origins(self, /) -> list[str]:
        """
        Origin period of each per-origin value.
        """
    @property
    def reserve(self, /) -> list[float]:
        """
        Reserve (ultimate minus latest) per origin.
        """
    def segment(self, /, **keys) -> ExpectedLossFit:
        """
        The fit of one segment, chosen by key values as
        ``ChainLadderFit.segment``.
        
        Returns
        -------
        ExpectedLossFit
        """
    def to_frame(self, /) -> Any:
        """
        One row per segment and origin: the key columns, ``origin``,
        ``latest``, ``ultimate``, ``reserve``, ``exposure`` and ``apriori``.
        Needs pandas.
        
        Returns
        -------
        pandas.DataFrame
        """
    @property
    def total_reserve(self, /) -> float:
        """
        Total reserve across segments and origins.
        """
    @property
    def total_ultimate(self, /) -> float:
        """
        Total ultimate across segments and origins.
        """
    def totals_frame(self, /) -> Any:
        """
        One row per segment: the key columns and the segment's total
        ``latest``, ``ultimate``, ``reserve`` and ``exposure``. Needs pandas.
        
        Returns
        -------
        pandas.DataFrame
        """
    @property
    def ultimate(self, /) -> list[float]:
        """
        This method's ultimate per origin.
        """

